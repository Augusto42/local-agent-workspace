{
  "app": {
    "name": "Local Agent Workspace",
    "tagline": "Research the web and work inside one approved folder.",
    "response_language": "the language used by the user"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8090,
    "allow_remote": false
  },
  "model": {
    "api_url": "http://127.0.0.1:8080/v1/chat/completions",
    "name": "local-model",
    "label": "OpenAI-compatible local model",
    "api_key_env": "LOCAL_AGENT_API_KEY",
    "temperature": 0.2,
    "max_tokens": 2048,
    "request_timeout_seconds": 300,
    "disable_thinking": false
  },
  "files": {
    "workspace": "./workspace",
    "static_root": "./ui/dist"
  },
  "web": {
    "search_url_template": "https://www.bing.com/search?format=rss&q={query}",
    "allowed_ports": [80, 443]
  },
  "limits": {
    "max_body_bytes": 2097152,
    "max_file_bytes": 524288,
    "max_fetch_bytes": 1048576,
    "max_tool_rounds": 10
  }
}
